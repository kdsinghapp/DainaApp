// ─── Main Component ───────────────────────────────────────────────────────────

export default function ChatInboxScreen() {
  const navigation = useNavigation<any>();

  const [chats, setChats] = useState<ChatItem[]>([]);
  const [loading, setLoading] = useState(false);
  const [refreshing, setRefreshing] = useState(false);
  const [query, setQuery] = useState("");
  const [error, setError] = useState<string | null>(null);
  const [userType, setUserType] = useState<string>("");

  // ── Fetch ─────────────────────────────────────────────────────────────────
  const fetchChats = useCallback(async (isRefresh = false) => {
    try {
      isRefresh ? setRefreshing(true) : setLoading(true);
      setError(null);

      // ✅ Auth se token + userType dono lo
      const storedAuth = await getAuthData();
      const token = storedAuth?.token ?? (await AsyncStorage.getItem("token"));
      const type: string = storedAuth?.userData?.type ?? "";

      console.log("userType:", type);
      setUserType(type);

      if (!token) {
        setError("Please log in again.");
        return;
      }

      const url = `${base_url}/chat/history`;
      const response = await fetch(url, {
        method: "GET",
        headers: {
          Authorization: `Bearer ${token}`,
          "Content-Type": "application/json",
          Accept: "application/json",
        },
      });

      if (response.status === 401 || response.status === 403) {
        setError("Session expired. Please log in again.");
        return;
      }

      if (!response.ok) throw new Error(`Server error: ${response.status}`);

      const json = await response.json();
      console.log("Chat history:", JSON.stringify(json, null, 2));

      // ✅ API shape: { status:1, chats: [...] }
      const raw: any[] = Array.isArray(json)
        ? json
        : Array.isArray(json?.chats)
        ? json.chats
        : json?.data ?? [];

      // ✅ userType pass karke proper data map karo
      setChats(raw.map((c) => mapChat(c, type)));
    } catch (err: any) {
      console.error("fetchChats error:", err);
      setError("Failed to load chats. Pull down to retry.");
    } finally {
      setLoading(false);
      setRefreshing(false);
    }
  }, []);

  useEffect(() => {
    fetchChats();
  }, [fetchChats]);

  // ── Filter ────────────────────────────────────────────────────────────────
  const filteredData = useMemo(() => {
    const q = query.trim().toLowerCase();
    if (!q) return chats;
    return chats.filter(
      (i) =>
        i.displayName.toLowerCase().includes(q) ||
        i.lastMessage.toLowerCase().includes(q) ||
        i.trackingId.toLowerCase().includes(q)
    );
  }, [query, chats]);

  // ── Message prefix ────────────────────────────────────────────────────────
  const getMessagePrefix = (item: ChatItem): string => {
    if (userType === "User") {
      // User dekh raha hai: agar driver ne bheja → "Driver: "
      return item.lastMessageSenderRole === "delivery" ? "Driver: " : "You: ";
    } else {
      // Delivery dekh raha hai: agar user ne bheja → "Owner: "
      return item.lastMessageSenderRole === "user" ? "Owner: " : "You: ";
    }
  };

  // ── Render Row ────────────────────────────────────────────────────────────
  const renderItem = ({ item }: { item: ChatItem }) => {
    console.log("item",item)
    return(
         <TouchableOpacity
      style={styles.row}
      activeOpacity={0.7}
      onPress={() =>
        navigation.navigate(ScreenNameEnum.ChatScreen, {
          chatId: item.id,
          parcelId: item.parcelId,
          chatName: item.displayName,
          trackingId: item.trackingId,
          driver: item.driver,
          parcelOwner: item.parcelOwner,
          parcel: item.parcel,
          deliveryStatus: item.deliveryStatus,
          userType,
        })
      }
    >
      {/* Avatar */}
      <View style={styles.avatarWrap}>
        <Image
          source={{ uri: item.displayAvatar }}
          style={styles.avatar}
         />
        {item.isOnline && <View style={styles.onlineDot} />}
      </View>

      {/* Content */}
      <View style={styles.textCol}>

        {/* Row 1: Name + Time */}
        <View style={styles.nameTimeRow}>
          <Text style={styles.name} numberOfLines={1}>
            {item.displayName}
          </Text>
          <Text style={styles.time}>{item.time}</Text>
        </View>

        {/* Row 2: Tracking ID + Status */}
        <View style={styles.trackingRow}>
          <Text style={styles.trackingId} numberOfLines={1}>
            🚚 {item.trackingId}
          </Text>
          <StatusBadge status={item.deliveryStatus} />
        </View>

        {/* Row 3: Last Message + Unread Badge */}
        <View style={styles.messageRow}>
          <Text
            style={[
              styles.lastMessage,
              !!item.unreadCount && styles.unreadMessage,
            ]}
            numberOfLines={1}
          >
            {getMessagePrefix(item)}
            {item.lastMessage || "No messages yet"}
          </Text>

          {!!item.unreadCount && (
            <View style={styles.badge}>
              <Text style={styles.badgeText}>
                {item.unreadCount > 99 ? "99+" : item.unreadCount}
              </Text>
            </View>
          )}
        </View>

      </View>
    </TouchableOpacity>
    )
  }

  // ── UI ────────────────────────────────────────────────────────────────────
  return (
    <SafeAreaView style={styles.container}>
      <StatusBarComponent />

      <Text style={styles.header}>Inbox</Text>

      {/* Search */}
      <View style={styles.searchBox}>
        <TextInput
          placeholder="Search by name or tracking ID…"
          placeholderTextColor="#9aa0a6"
          value={query}
          onChangeText={setQuery}
          style={styles.input}
          returnKeyType="search"
        />
      </View>

      {/* Error */}
      {!!error && (
        <View style={styles.errorBanner}>
          <Text style={styles.errorText}>{error}</Text>
        </View>
      )}

      {/* List */}
      
        <FlatList
          data={filteredData}
          style={styles.list}
          keyExtractor={(item) => item.id}
          renderItem={renderItem}
          ItemSeparatorComponent={() => <View style={styles.separator} />}
          contentContainerStyle={[
            { paddingBottom: 16 },
            filteredData.length === 0 && styles.emptyContainer,
          ]}
          showsVerticalScrollIndicator={false}
          ListEmptyComponent={<EmptyState />}
          refreshControl={
            <RefreshControl
              refreshing={refreshing}
              onRefresh={() => fetchChats(true)}
              colors={["#FFCC00"]}
              tintColor="#FFCC00"
            />
          }
        />
   
    </SafeAreaView>
  );
}

