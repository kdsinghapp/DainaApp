// ─── Types ───────────────────────────────────────────────────────────────────

type Person = {
  id: number;
  name: string | null;
  phone: string;
  image: string | null;
  email: string | null;
};

type ChatItem = {
  id: string;
  parcelId: number;
  trackingId: string;
  deliveryStatus: string;
  // ✅ Jo person dikhana hai uski info
  displayName: string;
  displayAvatar: string;
  lastMessage: string;
  lastMessageSenderRole: string;
  time: string;
  isOnline?: boolean;
  unreadCount?: number;
  totalMessages?: number;
  // Full data for navigation
  driver: Person;
  parcelOwner: Person;
  parcel: {
    pickupLocation: string;
    dropLocation: string;
    pickupDate: string | null;
    pickupTime: string | null;
    deliveryPrice: string | null;
  };
};

// ─── Helpers ─────────────────────────────────────────────────────────────────

const toTimeString = (raw: string | undefined): string => {
  if (!raw) return "";
  const date = new Date(raw);
  if (isNaN(date.getTime())) return raw;
  return date.toLocaleTimeString([], { hour: "2-digit", minute: "2-digit" });
};

const getDisplayInfo = (person: any): { name: string; avatar: string } => {
  const name =
    person?.name && String(person.name).trim() !== ""
      ? String(person.name).trim()
      : person?.phone ?? "Unknown";

  const avatar =
    person?.image ??
    `https://ui-avatars.com/api/?name=${encodeURIComponent(name)}&background=FFCC00&color=fff`;

  return { name, avatar };
};

/**
 * ✅ userType === "User"     → driver dikhao  (kaun deliver kar raha hai)
 * ✅ userType === "Delivery" → parcelOwner dikhao (kiska parcel hai)
 */
const mapChat = (c: any, userType: string): ChatItem => {
  const isUserSide = userType === "User";

  // User side pe driver dikhao, Delivery side pe parcelOwner dikhao
  const otherPerson = isUserSide ? c.driver : c.parcelOwner;
  const { name: displayName, avatar: displayAvatar } = getDisplayInfo(otherPerson);

  return {
    id: String(c.parcelId ?? Math.random()),
    parcelId: c.parcelId,
    trackingId: c.trackingId ?? "",
    deliveryStatus: c.deliveryStatus ?? "",
    displayName,
    displayAvatar,
    lastMessage: c.lastMessage?.text ?? "",
    lastMessageSenderRole: c.lastMessage?.senderRole ?? "",
    time: toTimeString(c.lastMessage?.time),
    isOnline: false,
    unreadCount: c.unreadCount ?? 0,
    totalMessages: c.totalMessages ?? 0,
    driver: {
      id: c.driver?.id ?? 0,
      name: c.driver?.name ?? "",
      phone: c.driver?.phone ?? "",
      image: c.driver?.image ?? null,
      email: c.driver?.email ?? null,
    },
    parcelOwner: {
      id: c.parcelOwner?.id ?? 0,
      name: c.parcelOwner?.name ?? null,
      phone: c.parcelOwner?.phone ?? "",
      image: c.parcelOwner?.image ?? null,
      email: c.parcelOwner?.email ?? null,
    },
    parcel: {
      pickupLocation: c.parcel?.pickupLocation ?? "",
      dropLocation: c.parcel?.dropLocation ?? "",
      pickupDate: c.parcel?.pickupDate ?? null,
      pickupTime: c.parcel?.pickupTime ?? null,
      deliveryPrice: c.parcel?.deliveryPrice ?? null,
    },
  };
};

// ─── Status Badge ─────────────────────────────────────────────────────────────

const StatusBadge = ({ status }: { status: string }) => {
  const colorMap: Record<string, { bg: string; text: string }> = {
    pending: { bg: "#FFF7E6", text: "#D97706" },
    delivered: { bg: "#F0FDF4", text: "#16A34A" },
    cancelled: { bg: "#FEF2F2", text: "#DC2626" },
    "in-transit": { bg: "#EFF6FF", text: "#2563EB" },
  };
  const colors = colorMap[status?.toLowerCase()] ?? { bg: "#F1F5F9", text: "#64748B" };

  return (
    <View style={[statusStyles.badge, { backgroundColor: colors.bg }]}>
      <Text style={[statusStyles.text, { color: colors.text }]}>
        {status ? status.charAt(0).toUpperCase() + status.slice(1) : "Unknown"}
      </Text>
    </View>
  );
};

const statusStyles = StyleSheet.create({
  badge: { borderRadius: 6, paddingHorizontal: 8, paddingVertical: 2 },
  text: { fontSize: 11,    fontFamily: font.MonolithRegular
 },
});

// ─── Empty State ──────────────────────────────────────────────────────────────

